# Fingerprinted files under /assets/ never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Icons are not fingerprinted, so they cache for a day, not forever.
/favicon.ico
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-32.png
  Cache-Control: public, max-age=86400
